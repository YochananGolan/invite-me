# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Application URL (used for invitation links in SMS/WhatsApp)
# MUST be the public URL - guests click this link. Never use localhost.
# For production: https://meet-m.co.il or https://invite-me-two.vercel.app
NEXT_PUBLIC_APP_URL=https://meet-m.co.il

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password
CONTACT_TO=your_email@gmail.com

# ActiveTrail API
ACTIVETRAIL_API_KEY=your_activetrail_api_key_here

# Tranzila Payment Configuration
# Note: Use TRANZILA (single L), not TRANZILLA
NEXT_PUBLIC_TRANZILA_TERMINAL=your_terminal_name
TRANZILA_TERMINAL_PASSWORD=your_terminal_password_here

# Optional: Tranzila API Key (if using direct API, not iframe)
TRANZILA_API_KEY=your_tranzila_api_key_here

# תזכורת אוטומטית חמישה ימים לפני האירוע (Cron)
# Vercel Cron קורא ל-/api/send-reminders מדי יום. אם מוגדר – רק בקשות עם Authorization: Bearer <CRON_SECRET> מתקבלות.
CRON_SECRET=your_random_secret_here
# מספר הימים לפני האירוע לשליחת התזכורת (ברירת מחדל: 5). התזכורת נשלחת לכולם באותו זמן.
# REMINDER_DAYS_BEFORE=5

# גישה מלאה ל-Supabase. חובה לתזכורות אוטומטיות ולקישור אישור הגעה (אורחים לא מאומתים).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# WhatsApp via GreenAPI (preferred in this project)
GREENAPI_URL=https://your-instance.api.greenapi.com
GREENAPI_TOKEN=your_greenapi_token_here
GREENAPI_ID_INSTANCE=your_instance_id_here
# Optional secret used to protect /api/greenapi/webhook (Bearer token or ?token=...)
GREENAPI_WEBHOOK_SECRET=your_greenapi_webhook_secret_here

# Optional fallback: WhatsApp Cloud API (Meta)
# META_WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# META_WHATSAPP_ACCESS_TOKEN=your_access_token

# Optional: parallel WhatsApp sends per request when using Meta Cloud API (default: 5)
# WHATSAPP_SEND_CONCURRENCY=5
# Green API: sends are serialized with a short gap by default (avoids rate limits / only-first-message-delivered)
# WHATSAPP_GREENAPI_SEND_GAP_MS=450
# WHATSAPP_GREENAPI_SEND_RETRIES=3

# Dev-only: same invite send as production (/api/greenapi/send-event-invite) but skips messages_sent_count RPC.
# Use a real eventId (+ optional guestIds / guestId); needs invited_guests with phones like the wizard.
# WHATSAPP_DEV_TEST_ENABLED=1
# WHATSAPP_DEV_TEST_SECRET=generate_a_long_random_string
# POST /api/greenapi/dev-whatsapp-template  (or alias /api/greenapi/dev-send-event-invite → 307 redirect)
# JSON: { "secret": "<...>", "eventId": "<uuid>", "guestIds": ["..."] }
# Omit guestIds and guestId to send to all guests on the event (same as auto-trigger after event create).
