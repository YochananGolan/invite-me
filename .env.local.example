# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Application URL (used for invitation links in SMS/WhatsApp)
# MUST be the public URL - guests click this link. Never use localhost.
# For production: https://meet-m.co.il or https://invite-me-two.vercel.app
NEXT_PUBLIC_APP_URL=https://meet-m.co.il

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password
CONTACT_TO=your_email@gmail.com

# ActiveTrail API
ACTIVETRAIL_API_KEY=your_activetrail_api_key_here

# Tranzila Payment Configuration
# Note: Use TRANZILA (single L), not TRANZILLA
NEXT_PUBLIC_TRANZILA_TERMINAL=your_terminal_name
TRANZILA_TERMINAL_PASSWORD=your_terminal_password_here

# Optional: Tranzila API Key (if using direct API, not iframe)
TRANZILA_API_KEY=your_tranzila_api_key_here

# תזכורת אוטומטית שלושה ימים לפני האירוע (Cron)
# Vercel Cron קורא ל-/api/send-reminders מדי יום. אם מוגדר – רק בקשות עם Authorization: Bearer <CRON_SECRET> מתקבלות.
CRON_SECRET=your_random_secret_here
# מספר הימים לפני האירוע לשליחת התזכורת (ברירת מחדל: 3). התזכורת נשלחת לכולם באותו זמן.
# REMINDER_DAYS_BEFORE=3

# גישה מלאה ל-Supabase. חובה לתזכורות אוטומטיות ולקישור אישור הגעה (אורחים לא מאומתים).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
