{
  "headers": [
    {
      "source": "/.well-known/apple-developer-merchantid-domain-association",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Content-Disposition", "value": "inline" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/send-reminders",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/archive-ended-events",
      "schedule": "10 21 * * *"
    }
  ]
}